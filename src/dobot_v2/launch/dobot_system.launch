<launch>
  <!-- Unified System Launcher for Dobot Magician Autonomous Stacking (ROS 1) -->
  <arg name="launch_cam" default="true" doc="Whether to launch usb_cam camera driver node"/>
  <arg name="launch_vision" default="true" doc="Whether to launch detection_node vision tracker"/>
  <arg name="launch_controller" default="true" doc="Whether to launch dobot_controller arm node"/>
  <arg name="launch_ui" default="true" doc="Whether to launch Dobot_UI dashboard"/>

  <arg name="video_device" default="/dev/video0" doc="V4L2 camera device path"/>
  <arg name="camera_info_url" default="file://$(find dobot_v2)/config/Test_cam_calibration.yaml" doc="Camera calibration YAML URL"/>
  <arg name="cam_params_file" default="$(find dobot_v2)/config/usb_cam.yaml" doc="Path to usb_cam parameters YAML"/>
  <arg name="detection_params_file" default="$(find dobot_v2)/config/detection_node.yaml" doc="Path to detection_node parameters YAML"/>
  <arg name="controller_params_file" default="$(find dobot_v2)/config/dobot_controller.yaml" doc="Path to dobot_controller parameters YAML"/>

  <!-- 1. Camera Driver Node (usb_cam) -->
  <group if="$(arg launch_cam)">
    <node name="usb_cam" pkg="usb_cam" type="usb_cam_node" output="screen" respawn="true">
      <param name="video_device" value="$(arg video_device)"/>
      <param name="camera_info_url" value="$(arg camera_info_url)"/>
      <rosparam command="load" file="$(arg cam_params_file)"/>
    </node>
  </group>

  <!-- 2. Detection Node (Pallet Grid & Multi-Color Cube Tracker) -->
  <group if="$(arg launch_vision)">
    <node name="detection_node" pkg="dobot_v2" type="detection_node.py" output="screen" respawn="true">
      <rosparam command="load" file="$(arg detection_params_file)"/>
    </node>
  </group>

  <!-- 3. Dobot Controller Node (Hardware Arm & Mission Trajectory Planner) -->
  <group if="$(arg launch_controller)">
    <node name="dobot_controller" pkg="dobot_v2" type="dobot_controller_node.py" output="screen" respawn="true">
      <rosparam command="load" file="$(arg controller_params_file)"/>
    </node>
  </group>

  <!-- 4. Dobot UI Dashboard (PyQt GUI) -->
  <group if="$(arg launch_ui)">
    <node name="dobot_ui" pkg="Dobot_UI" type="app.py" output="screen" respawn="false"/>
  </group>
</launch>
