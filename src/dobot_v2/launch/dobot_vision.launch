<launch>
  <!-- Dedicated Vision Launcher for Dobot Magician (ROS 1) -->
  <arg name="video_device" default="/dev/video0" doc="V4L2 camera device path"/>
  <arg name="camera_info_url" default="file://$(find dobot_v2)/config/Test_cam_calibration.yaml" doc="Camera calibration YAML URL"/>
  <arg name="cam_params_file" default="$(find dobot_v2)/config/usb_cam.yaml" doc="Path to usb_cam parameters YAML"/>
  <arg name="detection_params_file" default="$(find dobot_v2)/config/detection_node.yaml" doc="Path to detection_node parameters YAML"/>

  <!-- 1. Camera Driver Node -->
  <node name="usb_cam" pkg="usb_cam" type="usb_cam_node" output="screen" respawn="true">
    <param name="video_device" value="$(arg video_device)"/>
    <param name="camera_info_url" value="$(arg camera_info_url)"/>
    <rosparam command="load" file="$(arg cam_params_file)"/>
  </node>

  <!-- 2. Detection Node -->
  <node name="detection_node" pkg="dobot_v2" type="detection_node.py" output="screen" respawn="true">
    <rosparam command="load" file="$(arg detection_params_file)"/>
  </node>
</launch>
